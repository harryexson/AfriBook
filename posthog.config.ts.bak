interface PostHogClient {
  capture(event: { distinctId: string; event: string; properties?: Record<string, unknown> }): void;
  identify(data: { distinctId: string; properties?: Record<string, unknown> }): void;
  shutdown(): Promise<void>;
}

let client: PostHogClient | null = null;

export function getPostHogClient(): PostHogClient | null {
  if (client) return client;

  const key = process.env.NEXT_PUBLIC_POSTHOG_KEY;
  if (!key) return null;

  try {
    const { PostHog } = require('posthog-node');
    const host = process.env.NEXT_PUBLIC_POSTHOG_HOST ?? 'https://app.posthog.com';
    client = new PostHog(key, { host, flushAt: 20, flushInterval: 10000 }) as PostHogClient;
  } catch {
    return null;
  }

  return client;
}

export async function captureEvent(
  distinctId: string,
  event: string,
  properties?: Record<string, unknown>,
) {
  const ph = getPostHogClient();
  if (!ph) return;
  ph.capture({ distinctId, event, properties });
}

export async function identifyUser(
  distinctId: string,
  traits?: Record<string, unknown>,
) {
  const ph = getPostHogClient();
  if (!ph) return;
  ph.identify({ distinctId, properties: traits });
}

export async function shutdownPostHog() {
  if (client) {
    await client.shutdown();
    client = null;
  }
}
