# Copy selected values into .env.local; do not overwrite existing Neon settings.
# Leave unused values empty. Never commit credentials. See docs/API-SETUP.md.

# Core web / shared Neon infrastructure
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_NEON_URL=
NEXT_PUBLIC_NEON_DATA_API_URL=
NEXT_PUBLIC_NEON_AUTH_BASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_DATABASE_URL=

# Stripe: start with a matching TEST publishable/secret key pair.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_EVENTS=
# Optional subscription price IDs from your Stripe account
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Transactional email: select resend, sendgrid or postmark; console sends no email.
# Neon authentication emails are configured separately in Neon Auth.
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=

# SMS: currently implemented choices are twilio or console (no delivery).
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SignalHouse RESERVED ONLY: no adapter is implemented yet.
# These proposed application variable names are not a verified provider contract.
# Keep SMS_PROVIDER unchanged until the adapter and delivery tests are complete.
SIGNALHOUSE_API_KEY=
SIGNALHOUSE_API_BASE_URL=
SIGNALHOUSE_FROM_NUMBER=

# Cloudflare R2 uploads / public media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Mapping and routing (optional overrides)
MAPBOX_ACCESS_TOKEN=
# Photon search-as-you-type/reverse geocoding endpoint. The public demo is
# suitable for light testing; configure your own instance for production load.
PHOTON_API_URL=https://photon.komoot.io
OSRM_BASE_URL=
NEXT_PUBLIC_OSRM_BASE_URL=

# Regional payments: configure only the providers needed for enabled markets.
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_WEBHOOK_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_SHORTCODE_KE=
MPESA_SHORTCODE_TZ=
MPESA_SHORTCODE_UG=
MPESA_PASSKEY_KE=
MPESA_PASSKEY_TZ=
MPESA_PASSKEY_UG=
PAWAPAY_API_KEY=
PAWAPAY_ENV=
PAWAPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_NUMBER=
RAZORPAY_WEBHOOK_SECRET=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_ENV=
ADYEN_WEBHOOK_HMAC=
AIRWALLEX_CLIENT_ID=
AIRWALLEX_CLIENT_SECRET=
AIRWALLEX_REGION=
AIRWALLEX_WEBHOOK_SECRET=
DLOCAL_LOGIN=
DLOCAL_TRANS_KEY=
DLOCAL_ENV=
DLOCAL_WEBHOOK_SECRET=
