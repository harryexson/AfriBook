# Copy to mobile/.env.local. All EXPO_PUBLIC values are visible in the app bundle.
# Never put Stripe secrets, database passwords or messaging keys here.
# Use your deployed web API origin; for a physical phone use a reachable LAN URL.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Legacy Supabase paths only. Shared Neon mobile auth migration remains unfinished.
# Leave blank unless intentionally testing an existing legacy Supabase project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
